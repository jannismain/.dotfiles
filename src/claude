#!/bin/sh
alias agentbox="~/ext/agentbox/agentbox"

source ~/.dotfiles/private/secrets
# Claude Code via Requesty
function claude-cc() {
  # Preserve local auth-token overrides from .envrc files, including empty values.
  env \
    ENABLE_TOOL_SEARCH=1 \
    CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 \
    CLAUDE_CODE_ENABLE_TELEMETRY=0 \
    ANTHROPIC_BASE_URL="https://router.eu.requesty.ai" \
    ANTHROPIC_AUTH_TOKEN="${ANTHROPIC_AUTH_TOKEN-${REQUESTY_API_KEY}}" \
    ANTHROPIC_DEFAULT_SONNET_MODEL="claude-sonnet-5-5@eu[1m]" \
    ANTHROPIC_DEFAULT_HAIKU_MODEL="vertex/claude-haiku-4-5@europe-west1" \
    ANTHROPIC_DEFAULT_OPUS_MODEL="claude-opus-5-5@eu[1m]" \
    BASH_MAX_OUTPUT_LENGTH=15000 \
    claude "$@"
}

alias ccusage='pnpx ccusage "$@"'
alias claude-usage='ccusage'
alias opencode-usage='pnpx @ccusage/opencode@latest "$@"'

# Claude Code with Deepseek
function claude-deepseek() {
  env \
    -u ANTHROPIC_DEFAULT_HAIKU_MODEL \
    -u ANTHROPIC_DEFAULT_SONNET_MODEL \
    -u ANTHROPIC_DEFAULT_OPUS_MODEL \
    ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic \
    ANTHROPIC_AUTH_TOKEN="${DEEPSEEK_API_KEY}" \
    ANTHROPIC_MODEL=deepseek-v4-pro \
    ANTHROPIC_SMALL_FAST_MODEL=deepseek-v4-flash \
    ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash \
    ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro \
    ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro \
    command claude "$@"
}

alias cl="claude"
alias cld="claude-deepseek"
